# 환경변수 - 절대 커밋하지 않는다
.env
.env.local
frontend/.env
frontend/.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# 데이터 (원본 회의록 PDF는 용량이 크므로 제외)
data/raw/
data/pdfs/
incoming_data/

# ETL 산출물 (1.9GB — 파이프라인으로 재생성 가능). 단 리포트·평가 결과는 보존
data/v1/*
!data/v1/reports/

# qrels 후보 풀 (5.7MB — DB 본문 복사본). 검색이 결정적이라 qrels_pool.py 로 똑같이
# 재생성된다(2026-08-05 비결정성 제거). 반면 qrels_judged.jsonl 은 LLM 심판 호출
# 결과(비용·비재현)라 커밋한다 — 라벨 자산 자체이므로.
data/eval/qrels_pool.jsonl

