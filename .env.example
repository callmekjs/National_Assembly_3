# 백엔드 환경변수 (.env 파일로 복사 후 실제 값을 채운다)

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# 주의: 모델명은 env 가 아니라 코드 상수 (임베딩: search_vector.py·embeddings_v1.py,
# 답변: answer.py). 임베딩 모델을 env 로 바꾸면 질의/코퍼스 임베딩 공간이 어긋나
# 검색이 조용히 망가지므로, 모델 교체는 전량 재임베딩과 함께 코드에서 바꾼다.

# PostgreSQL + pgvector
DATABASE_URL=postgresql://user:password@host:5432/national_assembly

# CORS 허용 출처 (쉼표 구분). 비우면 개발 기본값 (localhost:5173, 127.0.0.1:5173)
BACKEND_CORS_ORIGINS=

# JWT 서명 비밀키 (auth.py) — 배포에서는 반드시 설정.
# 미설정 시 프로세스마다 무작위 키를 생성한다(위조 불가). 대신 서버 재기동마다
# 기존 토큰이 전부 무효가 되어 로그인이 풀린다 — 배포에서 설정해야 하는 실제 이유.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 디버그 엔드포인트 노출 (기본 꺼짐). 1 이면 /search/vector, /search/hybrid,
# /answer 가 등록된다 — 과금 호출이 /query 의 query_logs 비용 장부를 우회한다.
# 로컬 디버그에서만 켤 것. 공개 배포에서는 반드시 비워둔다.
ENABLE_DEBUG_ENDPOINTS=

# 프론트엔드 환경변수 (frontend/.env 파일로 별도 관리)
# VITE_API_URL=http://127.0.0.1:8000  # 비우면 기본 127.0.0.1:8000 (Windows 는 localhost 금지 — IPv6 +2초)

# 열린국회정보 Open API (open.assembly.go.kr — 의원 인적사항·정당, 3단계 정당 모듈용)
OPEN_ASSEMBLY=your_open_assembly_api_key_here

# Grounding 사전차단 임계 (무작위 유사도 기준선 0.386 실측 — 조정 가능)
GROUNDING_SIM_THRESHOLD=0.4

# 재순위(reranker) — LLM listwise rerank 로 하이브리드 상위 30 후보 재정렬.
# OPENAI_API_KEY 를 재사용한다 (별도 키 불필요). 키가 없으면 자동으로 꺼진다.
#
# 켜는 것을 권장 — 끄면 검색 품질이 급락한다 (2026-08-07 실측, 20문항 평가셋):
#   nDCG@5  ON 0.778 / OFF 0.326
# 대신 질문당 LLM 호출 1회(재순위)가 추가돼 비용·지연이 는다. 비용을 한 푼도
# 쓰지 않을 로컬 실험에서만 0 으로 두고, 그 결과를 품질 기준으로 삼지 말 것.
RERANKER_ENABLED=1
# 재순위 모델·사고량 (미지정 시 아래 값).
# 오전엔 sol 이 최고였으나(0.768) 같은 날 검색에 IDF 가중치를 넣고 재니 뒤집혔다:
#   sol nDCG@5 0.755 / luna 0.762 (strict R@5 는 둘 다 1.000)
# 검색이 좋은 후보를 이미 위로 올려주니 재순위 모델의 힘이 덜 중요해진 것이다.
# 비용은 25배 차이 — 재순위는 후보 30개(~8,400토큰)를 매번 보내므로 단가가 곧 질의
# 비용이다. sol $0.047 → luna $0.002. 사고량은 낮은 쪽이 품질·지연 모두 낫다.
RERANKER_MODEL=gpt-5.6-luna
RERANKER_EFFORT=low

# 답변 생성 모델 (2026-08-07 실측 채택). 정답지 대비 18문항 채점:
#   gpt-4o-mini 7/18·환각19  /  gpt-5.6-terra 13/18·환각5  /  gpt-5.6-sol 12/18·환각8
# terra 가 더 맞히고 환각도 적고 글도 짧다. 재순위와 답변은 서로 다른 모델이다.
ANSWER_MODEL=gpt-5.6-terra
ANSWER_EFFORT=low

# 배포 방어선 (4단계-A) — 0 이면 해당 방어 끔
RATE_LIMIT_LLM_PER_MIN=5      # /query·/answer IP당 분당 한도
RATE_LIMIT_PER_MIN=60         # 그 외 경로 IP당 분당 한도
DAILY_COST_LIMIT_USD=3.0      # 일별 OpenAI 비용 상한 (query_logs 합산, 60초 캐시)
                              # 질의당 qa $0.014·report $0.035 → 약 120질의/일

# 배포(4단계-B) — 원격 Supabase 접속 문자열 (make_deploy_corpus.py 전용, 절대 커밋 금지)
# DEPLOY_DATABASE_URL=postgresql://...supabase.co:5432/postgres
